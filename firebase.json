{
  "functions": {
    "source": "functions"
  },
  "database": {
    "rules": "database/firebase-rules.json"
  },
  "storage": {
    "rules": "database/storage.rules"
  },
  "hosting": {
    "site": "rastreoflota-53052",
    "public": "passenger-app/build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "database": {
      "port": 9000
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
