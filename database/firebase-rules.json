{
  "rules": {
    "config": {
      ".read": true,
      "supportPhone": { ".write": "auth != null && auth.token.dashboardUser === true", ".validate": "newData.isString() && newData.val().length > 0" },
      "driverAppBuild": { ".write": "auth != null && auth.token.dashboardAdmin === true", ".validate": "newData.isNumber() && newData.val() > 0" },
      "passengerAppBuild": { ".write": "auth != null && auth.token.dashboardAdmin === true", ".validate": "newData.isNumber() && newData.val() > 0" },
      "dashboardName": { ".write": "auth != null && auth.token.dashboardAdmin === true", ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
      "dashboardLogoUrl": { ".write": "auth != null && auth.token.dashboardAdmin === true", ".validate": "newData.isString() && newData.val().length > 0" },
      "appBranding": {
        ".write": "auth != null && auth.token.dashboardAdmin === true",
        "$app": {
          ".validate": "$app === 'driver' || $app === 'passenger'",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
          "iconUrl": { ".validate": "newData.isString() && newData.val().length > 0" },
          "$other": { ".validate": false }
        }
      },
      "sportVenues": {
        ".write": "auth != null && auth.token.dashboardAdmin === true",
        "$venueId": {
          "name": { ".validate": "newData.isString() && newData.val().length > 0" },
          "address": { ".validate": "newData.isString()" },
          "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "$other": { ".validate": false }
        }
      },
      "hotels": {
        ".write": "auth != null && auth.token.dashboardAdmin === true",
        "$hotelId": {
          "name": { ".validate": "newData.isString() && newData.val().length > 0" },
          "address": { ".validate": "newData.isString()" },
          "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "$other": { ".validate": false }
        }
      },
      "$other": { ".validate": false }
    },
    "drivers": {
      ".read": "auth != null",
      ".indexOn": ["status", "approvalStatus"],
      "$driverId": {
        ".write": "auth != null && auth.uid === $driverId",
        "email": { ".validate": "newData.isString() && newData.val().length > 0 && (data.parent().child('approvalStatus').val() != 'rejected' || newData.val() == data.val())" },
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && (data.parent().child('approvalStatus').val() != 'rejected' || newData.val() == data.val())" },
        "age": { ".validate": "newData.isNumber() && newData.val() > 17 && newData.val() < 100 && (data.parent().child('approvalStatus').val() != 'rejected' || newData.val() == data.val())" },
        "plate": { ".validate": "newData.isString() && newData.val().length > 0 && (data.parent().child('approvalStatus').val() != 'rejected' || newData.val() == data.val())" },
        "vehicleBrand": { ".validate": "newData.isString() && newData.val().length > 0 && (data.parent().child('approvalStatus').val() != 'rejected' || newData.val() == data.val())" },
        "vehicleType": { ".validate": "newData.isString() && newData.val().matches(/^(Auto|SUV|Mini van|Van|Mini bus|Bus)$/) && (data.parent().child('approvalStatus').val() != 'rejected' || newData.val() == data.val())" },
        "vehicleColor": { ".validate": "newData.isString() && newData.val().matches(/^(Negro|Gris|Plata|Blanco)$/) && (data.parent().child('approvalStatus').val() != 'rejected' || newData.val() == data.val())" },
        "vehicleSeats": { ".validate": "newData.isNumber() && ((newData.parent().child('vehicleType').val() == 'Auto' && newData.val() >= 1 && newData.val() <= 4) || (newData.parent().child('vehicleType').val() == 'SUV' && newData.val() >= 5 && newData.val() <= 7) || (newData.parent().child('vehicleType').val() == 'Mini van' && newData.val() >= 8 && newData.val() <= 17) || (newData.parent().child('vehicleType').val() == 'Van' && newData.val() >= 18 && newData.val() <= 20) || (newData.parent().child('vehicleType').val() == 'Mini bus' && newData.val() >= 21 && newData.val() <= 38) || (newData.parent().child('vehicleType').val() == 'Bus' && newData.val() >= 39 && newData.val() <= 45)) && (data.parent().child('approvalStatus').val() != 'rejected' || newData.val() == data.val())" },
        "phone": { ".validate": "newData.isString() && (data.parent().child('approvalStatus').val() != 'rejected' || newData.val() == data.val())" },
        "dni": { ".validate": "newData.isString() && (data.parent().child('approvalStatus').val() != 'rejected' || newData.val() == data.val())" },
        "profilePhotoUrl": { ".validate": "newData.isString() && (data.parent().child('approvalStatus').val() != 'rejected' || data.parent().child('rejectionFieldKeys').val() == null || data.parent().child('rejectionFieldKeys').val().contains('profile'))" },
        "dniDocUrl": { ".validate": "newData.isString() && (data.parent().child('approvalStatus').val() != 'rejected' || data.parent().child('rejectionFieldKeys').val() == null || data.parent().child('rejectionFieldKeys').val().contains('dni'))" },
        "dniFrontDocUrl": { ".validate": "newData.isString() && (data.parent().child('approvalStatus').val() != 'rejected' || data.parent().child('rejectionFieldKeys').val() == null || data.parent().child('rejectionFieldKeys').val().contains('dni'))" },
        "dniBackDocUrl": { ".validate": "newData.isString() && (data.parent().child('approvalStatus').val() != 'rejected' || data.parent().child('rejectionFieldKeys').val() == null || data.parent().child('rejectionFieldKeys').val().contains('dni'))" },
        "licenseDocUrl": { ".validate": "newData.isString() && (data.parent().child('approvalStatus').val() != 'rejected' || data.parent().child('rejectionFieldKeys').val() == null || data.parent().child('rejectionFieldKeys').val().contains('license'))" },
        "soatDocUrl": { ".validate": "newData.isString() && (data.parent().child('approvalStatus').val() != 'rejected' || data.parent().child('rejectionFieldKeys').val() == null || data.parent().child('rejectionFieldKeys').val().contains('soat'))" },
        "circulationCardDocUrl": { ".validate": "newData.isString() && (data.parent().child('approvalStatus').val() != 'rejected' || data.parent().child('rejectionFieldKeys').val() == null || data.parent().child('rejectionFieldKeys').val().contains('circulationCard'))" },
        "technicalReviewDocUrl": { ".validate": "newData.isString() && (data.parent().child('approvalStatus').val() != 'rejected' || data.parent().child('rejectionFieldKeys').val() == null || data.parent().child('rejectionFieldKeys').val().contains('technicalReview'))" },
        "criminalRecordDocUrl": { ".validate": "newData.isString() && (data.parent().child('approvalStatus').val() != 'rejected' || data.parent().child('rejectionFieldKeys').val() == null || data.parent().child('rejectionFieldKeys').val().contains('criminalRecord'))" },
        "workCertificateDocUrl": { ".validate": "newData.isString() && (data.parent().child('approvalStatus').val() != 'rejected' || data.parent().child('rejectionFieldKeys').val() == null || data.parent().child('rejectionFieldKeys').val().contains('workCertificate'))" },
        "registeredAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())" },
        "documentsSubmittedAt": { ".validate": "newData.isNumber()" },
        "profileEditUsed": { ".validate": "newData.isBoolean()" },
        "profileEditedAt": { ".validate": "newData.isNumber()" },
        "approvalStatus": {
          ".write": "auth != null && (auth.uid === $driverId || auth.token.firebase.sign_in_provider === 'password')",
          ".validate": "newData.isString() && ((auth.uid === $driverId && newData.val() == 'pending_review' && (!data.exists() || data.val() == 'pending_review' || data.val() == 'rejected')) || (auth.token.firebase.sign_in_provider === 'password' && (newData.val() == 'approved' || newData.val() == 'rejected')))"
        },
        "rejectionReason": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
          ".validate": "auth != null && auth.token.firebase.sign_in_provider === 'password' && newData.isString()"
        },
        "rejectionFieldKeys": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
          ".validate": "auth != null && auth.token.firebase.sign_in_provider === 'password' && newData.isString()"
        },
        "reviewedAt": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
          ".validate": "auth != null && auth.token.firebase.sign_in_provider === 'password' && newData.isNumber()"
        },
        "reviewedBy": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
          ".validate": "auth != null && auth.token.firebase.sign_in_provider === 'password' && newData.isString()"
        },
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90 && root.child('drivers').child($driverId).child('approvalStatus').val() == 'approved'" },
        "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180 && root.child('drivers').child($driverId).child('approvalStatus').val() == 'approved'" },
        "lastUpdate": { ".validate": "newData.isNumber() && root.child('drivers').child($driverId).child('approvalStatus').val() == 'approved'" },
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'busy' || newData.val() == 'online') && root.child('drivers').child($driverId).child('approvalStatus').val() == 'approved'"
        },
        "currentTripId": { ".validate": "newData.isString() && root.child('drivers').child($driverId).child('approvalStatus').val() == 'approved'" },
        "fcmToken": { ".validate": "newData.isString()" },
        "activeSessionId": { ".validate": "newData.isString()" },
        "assignedPlace": {
          ".write": "auth != null && auth.token.dashboardAdmin === true",
          "name": { ".validate": "newData.isString()" },
          "type": { ".validate": "newData.isString()" },
          "assignedAt": { ".validate": "newData.isNumber()" }
        },
        "$other": { ".validate": false }
      }
    },
    "passengers": {
      ".read": "auth != null",
      "$passengerId": {
        ".write": "auth != null && auth.uid === $passengerId",
        "name": { ".validate": "newData.isString() && newData.val().length > 0" },
        "phone": { ".validate": "newData.isString()" },
        "credentialPhotoUrl": { ".validate": "newData.isString()" },
        "registeredAt": { ".validate": "newData.isNumber()" },
        "fcmToken": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },
    "trips": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".indexOn": ["passengerId", "driverId", "requestedAt", "status"],
      "$tripId": {
        ".read": "auth != null && (data.child('passengerId').val() === auth.uid || data.child('driverId').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('passengerId').val() === auth.uid && (newData.child('status').val() === 'searching' || newData.child('status').val() === 'scheduled')) || (data.exists() && data.child('passengerId').val() === auth.uid && !data.child('status').val().matches(/^(completed|cancelled)$/) && (newData.child('status').val() === data.child('status').val() || (newData.child('status').val() === 'cancelled' && !data.child('status').val().matches(/^(in_progress|completed|cancelled)$/)))) || (data.exists() && data.child('driverId').val() === auth.uid && newData.child('status').val() !== 'cancelled') || (data.exists() && auth.token.firebase.sign_in_provider === 'password'))",
        "passengerId": { ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())" },
        "passengerName": { ".validate": "newData.isString()" },
        "passengerPhone": { ".validate": "newData.isString()" },
        "passengerCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 45 && (!data.exists() || newData.val() == data.val())" },
        "pickupLat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90 && (!data.exists() || newData.val() == data.val())" },
        "pickupLng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180 && (!data.exists() || newData.val() == data.val())" },
        "pickupAddress": { ".validate": "newData.isString()" },
        "destinationLat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "destinationLng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "destinationAddress": { ".validate": "newData.isString()" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(scheduled|searching|assigned_pending_accept|accepted|rejected|arrived_at_pickup|in_progress|completed|cancelled|no_drivers_available)$/)" },
        "driverId": { ".validate": "newData.isString()" },
        "driverName": { ".validate": "newData.isString()" },
        "driverPhone": { ".validate": "newData.isString()" },
        "driverPlate": { ".validate": "newData.isString()" },
        "vehicleBrand": { ".validate": "newData.isString()" },
        "vehicleType": { ".validate": "newData.isString()" },
        "vehicleColor": { ".validate": "newData.isString()" },
        "vehicleSeats": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100" },
        "rejectedDriverIds": {
          "$rejectedId": { ".validate": "newData.isBoolean()" }
        },
        "requestedAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())" },
        "scheduledPickupLabel": { ".validate": "newData.isString()" },
        "scheduledPickupAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())" },
        "assignedAt": { ".validate": "newData.isNumber()" },
        "acceptedAt": { ".validate": "newData.isNumber()" },
        "arrivedAt": { ".validate": "newData.isNumber()" },
        "inProgressAt": { ".validate": "newData.isNumber()" },
        "completedAt": { ".validate": "newData.isNumber()" },
        "cancelledAt": { ".validate": "newData.isNumber()" },
        "cancelledBy": { ".validate": "newData.isString()" },
        "cancelReason": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },
    "tripHistory": {
      ".read": "auth != null && auth.token.dashboardAdmin === true",
      ".write": false
    },
    "driverConnectionHistory": {
      ".read": "auth != null && auth.token.dashboardAdmin === true",
      ".write": false
    }
  }
}
